# Desarrollo local (DJANGO_ENV usa development por defecto).
# En producción, DJANGO_ENV debe definirse explícitamente en el entorno del proceso.
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=

# PostgreSQL es obligatorio en todos los entornos.
POSTGRES_DB=yerbas_coronado
POSTGRES_USER=yerbas_coronado
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=0
POSTGRES_SSLMODE=prefer

# Opcionales. Los booleanos admiten únicamente true o false.
WHATSAPP_BUSINESS_NUMBER=
DJANGO_LOG_LEVEL=INFO
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
DJANGO_TRUST_X_FORWARDED_PROTO=false

# Gunicorn (Railway define PORT automáticamente).
PORT=8000
GUNICORN_WORKERS=1
GUNICORN_THREADS=1
GUNICORN_TIMEOUT=60
GUNICORN_GRACEFUL_TIMEOUT=30
